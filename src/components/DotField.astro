<canvas class="dot-field" aria-hidden="true"></canvas>

<style is:global>
  body.body:has(.dot-field) {
    isolation: isolate;
    background-image: none;
  }

  body.body:has(.dot-field) .hero-content {
    background-image: none;
  }

  .dot-field {
    position: fixed;
    /* Match the original grid.png footprint and fixed background position. */
    top: 88px;
    right: 0;
    width: 620px;
    height: 622px;
    max-width: none;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".dot-field");
  const context = canvas?.getContext("2d");
  if (canvas && context) {
    const motion = matchMedia("(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)");
    const pointer = { x: -1000, y: -1000 };
    let dots: { x: number; y: number; dx: number; dy: number; glow: number }[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastTime = 0;

    function draw(time: number) {
      frame = 0;
      const ease = 1 - Math.exp(-Math.min(time - lastTime || 16, 40) / 140);
      lastTime = time;
      context!.clearRect(0, 0, width, height);
      let settling = false;
      for (const dot of dots) {
        const x = dot.x - pointer.x;
        const y = dot.y - pointer.y;
        const distance = Math.hypot(x, y);
        const influence = motion.matches ? Math.max(0, 1 - distance / 150) ** 2 : 0;
        const targetX = (x / (distance || 1)) * influence * 7;
        const targetY = (y / (distance || 1)) * influence * 7;
        dot.dx += (targetX - dot.dx) * ease;
        dot.dy += (targetY - dot.dy) * ease;
        dot.glow += (influence - dot.glow) * ease;
        settling ||= Math.abs(targetX - dot.dx) + Math.abs(targetY - dot.dy) + Math.abs(influence - dot.glow) > 0.002;
        context!.fillStyle = `rgba(128, 218, 179, ${0.14 + dot.glow * 0.19})`;
        context!.beginPath();
        context!.arc(dot.x + dot.dx, dot.y + dot.dy, 0.85, 0, Math.PI * 2);
        context!.fill();
      }
      if (settling) schedule();
    }

    function schedule() {
      if (!frame && !document.hidden) frame = requestAnimationFrame(draw);
    }

    function resize() {
      const bounds = canvas!.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      canvas!.width = Math.round(width * ratio);
      canvas!.height = Math.round(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);
      dots = [];
      for (let y = 20; y < height; y += 40) {
        for (let x = 20; x < width; x += 40) {
          dots.push({ x, y, dx: 0, dy: 0, glow: 0 });
        }
      }
      schedule();
    }

    function reset() {
      pointer.x = pointer.y = -1000;
      schedule();
    }

    window.addEventListener("pointermove", (event) => {
      if (!motion.matches || event.pointerType === "touch") return;
      const bounds = canvas!.getBoundingClientRect();
      pointer.x = event.clientX - bounds.left;
      pointer.y = event.clientY - bounds.top;
      schedule();
    }, { passive: true });
    document.documentElement.addEventListener("pointerleave", reset);
    window.addEventListener("blur", reset);
    window.addEventListener("resize", resize, { passive: true });
    motion.addEventListener("change", reset);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(frame);
        frame = 0;
      } else reset();
    });
    resize();
  }
</script>
